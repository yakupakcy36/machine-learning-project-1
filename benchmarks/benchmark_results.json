{
  "project": "Diabetes Clinical Risk Prediction",
  "dataset": "Pima Indians Clinical Metabolic Cohort (N=768, d=8)",
  "validation_scheme": "5-Fold Stratified Cross-Validation",
  "features": [
    "Pregnancies",
    "Plasma_Glucose_mg_dL",
    "Diastolic_BP_mm_Hg",
    "Triceps_Skin_Fold_mm",
    "Serum_Insulin_mu_U_ml",
    "BMI_kg_m2",
    "Diabetes_Pedigree_Fn",
    "Age_years"
  ],
  "results": [
    {
      "model": "SVM (RBF Kernel)",
      "accuracy": 0.8711,
      "precision": 0.8627,
      "recall": 0.75,
      "f1": 0.8024,
      "roc_auc": 0.921,
      "roc_auc_std": 0.0132
    },
    {
      "model": "HistGradientBoosting",
      "accuracy": 0.8516,
      "precision": 0.8438,
      "recall": 0.7052,
      "f1": 0.7683,
      "roc_auc": 0.9086,
      "roc_auc_std": 0.0194
    },
    {
      "model": "Random Forest (200 Trees)",
      "accuracy": 0.8346,
      "precision": 0.8507,
      "recall": 0.6381,
      "f1": 0.7292,
      "roc_auc": 0.9038,
      "roc_auc_std": 0.0115
    }
  ]
}